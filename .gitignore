# Dependencies
node_modules/

# Environment files — real secrets never belong in the repo.
# The committed templates (.env.example) are placeholders only.
.env
.env.local
.env.*.local
!.env.example

# Build output
dist/
build/
dist-ssr/
.vite/
.cache/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime output — captured server stdout, not source
out.txt
*.out.txt

# Local MongoDB data (created by DB_MODE=auto/local) — never commit a database
.data/
backend/.data/

# User-uploaded template archives and images — generated at runtime
backend/uploads/
uploads/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript / tooling artifacts
*.tsbuildinfo
.eslintcache
