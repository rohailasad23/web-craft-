# ============================================================
# web craft -- backend configuration
# Copy to backend/.env . NEVER commit the real .env.
# ============================================================

# ===== REQUIRED =====
PORT=8080
NODE_ENV=development

# Long random string (32+ chars). The server refuses to start without it.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ===== DATABASE =====
#   auto   (default) Try MONGODB_URI first; if unreachable, start a local
#                     MongoDB automatically so development never hard-stops.
#   atlas             MONGODB_URI only -- fail fast if it is unreachable.
#   local             Skip Atlas entirely, always use the local MongoDB.
#
# "local" uses mongodb-memory-server. Data is stored in backend/.data/mongo,
# so it survives restarts and needs no Atlas account or IP allow-listing.
# Pre-download the binary once with:  npm run warmup-db   (inside backend/)
DB_MODE=auto

# Only used when DB_MODE is auto/atlas. Leave as-is if you use local only.
MONGODB_URI=mongodb://localhost:27017/web-craft

# Optional overrides for the local database:
# LOCAL_MONGO_VERSION=7.0.21
# LOCAL_DB_PATH=./.data/mongo
# LOCAL_DB_PORT=27017

# ===== CORS =====
# Comma-separated list of allowed frontend origins.
# Leave blank in development to allow all; SET THIS IN PRODUCTION.
CORS_ORIGINS=http://localhost:5173

# ===== FILE UPLOADS (limits are enforced in code) =====
# Archives (.zip) 25MB, images 5MB, max 5 screenshots per template.
# Uploaded files land in backend/uploads/ and are served from /uploads.
# To move to S3 / R2 / Cloudinary later, change backend/services/storage.js
# only -- the database stores a key, never the bytes.
# (No environment variable is required for local storage.)

# ===== USED ONLY BY THE SMOKE TEST =====
# SMOKE_PORT=8099
