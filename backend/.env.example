# ===== REQUIRED =====
PORT=8080
NODE_ENV=development

# Long random string (32+ chars). The server refuses to start without it.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ===== DATABASE =====
#   auto   (default) Try MONGODB_URI first; if unreachable, start a local
#                     MongoDB automatically so development never hard-stops.
#   atlas             MONGODB_URI only -- fail fast if it is unreachable.
#   local             Skip Atlas entirely, always use the local MongoDB.
#
# "local" uses mongodb-memory-server. Data is stored in backend/.data/mongo,
# so it survives restarts and needs no Atlas account or IP allow-listing.
# Pre-download the binary once with:  npm run warmup-db   (inside backend/)
DB_MODE=auto

# Only used when DB_MODE is auto/atlas. Leave as-is if you use local only.
MONGODB_URI=mongodb://localhost:27017/landing-builder

# Optional overrides for the local database:
# LOCAL_MONGO_VERSION=7.0.21
# LOCAL_DB_PATH=./.data/mongo
# LOCAL_DB_PORT=27017

# ===== OPTIONAL: AI copy generation =====
# Configure at least one. If none are set the app still works and falls back
# to deterministic template copy (the UI is told via provider === 'template').
# Anthropic key must start with sk-ant- and be a real key.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Or OpenAI:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Or local, free, no key (install Ollama then `ollama pull llama3.2`):
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# ===== OPTIONAL: stock images =====
# Without this the app serves built-in SVG placeholders (no broken images).
UNSPLASH_API_KEY=

# ===== OPTIONAL: payments =====
# Without these /api/payment/create-order returns 503 with a clear message.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ===== OPTIONAL: publishing =====
# Base URL used in published links. Defaults to http://localhost:PORT
PUBLIC_BASE_URL=http://localhost:8080

# Comma-separated list of allowed frontend origins.
# Leave blank in development to allow all; SET THIS IN PRODUCTION.
CORS_ORIGINS=http://localhost:5173
