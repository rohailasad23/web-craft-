{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup: install dependencies",
      "type": "shell",
      "command": "npm run setup",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Dev: API + Web (both)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "(dev|vite|Server running|ready in)",
          "endsPattern": "(Local:.*5173|Server running on http://localhost:8080)"
        }
      },
      "group": "build"
    },
    {
      "label": "API only",
      "type": "shell",
      "command": "npm run dev --prefix backend",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "node",
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Server running on http://localhost:"
        }
      }
    },
    {
      "label": "Web only (Vite)",
      "type": "shell",
      "command": "npm run dev --prefix frontend",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:.*5173"
        }
      }
    },
    {
      "label": "Smoke test (31 checks)",
      "type": "shell",
      "command": "npm run smoke",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "npm run lint",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Build frontend",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "build"
    }
  ]
}
